DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cfpb
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_PORT=5001
MLFLOW_MODEL_NAME=cfpb-complaint-classifier
MLFLOW_MODEL_ALIAS=champion
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false
MLFLOW_DB_PASSWORD=mlflow
RABBITMQ_USER=cfpb
RABBITMQ_PASSWORD=cfpb-local-password
RABBITMQ_URL=amqp://cfpb:cfpb-local-password@127.0.0.1:5672/
TASK_QUEUE_NAME=complaints.tasks
BACKPRESSURE_ENABLED=true
QUEUE_MAX_LENGTH=20
WORKER_CONCURRENCY=2
PREFETCH_COUNT=2
INFERENCE_DELAY_SECONDS=1
PUBLISH_TIMEOUT_SECONDS=1
SOURCE_RETRY_INITIAL_SECONDS=0.05
SOURCE_RETRY_MAX_SECONDS=0.5
SHUTDOWN_TIMEOUT_SECONDS=30
WORKER_STOP_GRACE_PERIOD=40s
TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_SECONDS=0.5
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
